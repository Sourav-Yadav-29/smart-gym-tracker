<!-- Quick-action modals (native <dialog>) -->
<dialog id="m-member" class="modal"><form method="post" action="/admin/actions">
  <input type="hidden" name="action" value="add_member"><input type="hidden" name="back" value="/admin?page=members">
  <h3>Enroll new member</h3><p class="muted">Create a member with plan, expiry and starting biometrics.</p>
  <div class="grid2"><label>Full name<input name="name" required placeholder="Rohan Verma" data-testid="member-name-input"></label>
  <label>Email<input name="email" type="email" required placeholder="rohan@ironpulse.com" data-testid="member-email-input"></label></div>
  <div class="grid2"><label>Phone<input name="phone" placeholder="+91 98765 43210"></label>
  <label>Plan<select name="plan_id"><% plans.forEach(p => { %><option value="<%= p.plan_id %>"><%= p.plan_name %> (<%= inr(p.price) %>)</option><% }) %></select></label></div>
  <div class="grid2"><label>Plan expiry<input name="plan_end_date" type="date" value="<%= nextYear %>"></label>
  <label>Initial password<input name="password" type="password" value="password123"></label></div>
  <div class="grid3"><label>Height (cm)<input name="height_cm" type="number" step="0.1" value="175"></label><label>Weight (kg)<input name="weight_kg" type="number" step="0.1" value="75"></label><label>Body fat %<input name="body_fat_pct" type="number" step="0.1" value="15"></label></div>
  <label>Fitness goal<input name="fitness_goal" value="General Fitness"></label>
  <footer><button type="button" class="btn" onclick="closeModal(this)">Cancel</button><button class="btn primary" data-testid="member-form-submit-button">Create member</button></footer>
</form></dialog>

<dialog id="m-payment" class="modal"><form method="post" action="/admin/actions">
  <input type="hidden" name="action" value="add_payment"><input type="hidden" name="back" value="<%= selfUrl %>">
  <h3>Record member payment</h3><p class="muted">Logs a verified payment and sends the member a receipt.</p>
  <label>Member<select name="member_id" required onchange="prefillAmount(this)"><option value="">Select member</option><% members.forEach(m => { %><option value="<%= m.member_id %>" data-price="<%= m.plan_price || 0 %>"><%= m.name %> · <%= m.plan_name || 'No plan' %></option><% }) %></select></label>
  <div class="grid2"><label>Amount (₹)<input name="amount" type="number" step="0.01" min="1" required></label><label>Date<input name="payment_date" type="date" value="<%= todayDate %>"></label></div>
  <label>Method<select name="method"><option>UPI / NetBanking</option><option>Credit Card</option><option>Cash</option></select></label>
  <footer><button type="button" class="btn" onclick="closeModal(this)">Cancel</button><button class="btn primary">Record payment</button></footer>
</form></dialog>

<dialog id="m-checkin" class="modal"><form method="post" action="/admin/actions">
  <input type="hidden" name="action" value="checkin"><input type="hidden" name="back" value="<%= selfUrl %>">
  <h3>Record gate check-in</h3><p class="muted">Starts an attendance session (shown as Online in Access Logs).</p>
  <label>Member<select name="member_id" required><option value="">Select member</option><% members.forEach(m => { %><option value="<%= m.member_id %>"><%= m.name %> · <%= m.plan_name || 'No plan' %></option><% }) %></select></label>
  <footer><button type="button" class="btn" onclick="closeModal(this)">Cancel</button><button class="btn primary">Check in</button></footer>
</form></dialog>

<dialog id="m-slot" class="modal"><form method="post" action="/admin/actions">
  <input type="hidden" name="action" value="add_booking"><input type="hidden" name="back" value="<%= selfUrl %>">
  <h3>Assign client to trainer slot</h3><p class="muted">Leave locker blank to auto-assign one.</p>
  <label>Member<select name="member_id" required><option value="">Select member</option><% members.forEach(m => { %><option value="<%= m.member_id %>"><%= m.name %> · <%= m.plan_name || 'No plan' %></option><% }) %></select></label>
  <label>Trainer<select name="trainer_id" required><% trainers.forEach(t => { %><option value="<%= t.trainer_id %>"><%= t.name %> · <%= t.specialization %></option><% }) %></select></label>
  <div class="grid2"><label>Slot time<select name="slot_time"><option>07:00 AM - 08:00 AM</option><option>09:30 AM - 10:30 AM</option><option>05:00 PM - 06:00 PM</option><option>07:00 PM - 08:00 PM</option></select></label><label>Locker (optional)<input name="locker_number" placeholder="Auto-assign"></label></div>
  <footer><button type="button" class="btn" onclick="closeModal(this)">Cancel</button><button class="btn primary">Assign slot</button></footer>
</form></dialog>

<dialog id="m-remind" class="modal"><form method="post" action="/admin/actions">
  <input type="hidden" name="action" value="send_reminder"><input type="hidden" name="back" value="<%= selfUrl %>">
  <h3>Send payment due reminder</h3><p class="muted">The member gets an in-app dues alert.</p>
  <label>Member<select name="member_id" required><option value="">Select member</option><% members.forEach(m => { %><option value="<%= m.member_id %>"><%= m.name %> · due <%= m.plan_end_date ? m.plan_end_date.toISOString().split('T')[0] : '—' %></option><% }) %></select></label>
  <footer><button type="button" class="btn" onclick="closeModal(this)">Cancel</button><button class="btn primary">Send reminder</button></footer>
</form></dialog>

<dialog id="m-trainer" class="modal"><form method="post" action="/admin/actions">
  <input type="hidden" name="action" value="add_trainer"><input type="hidden" name="back" value="/admin?page=trainers">
  <h3>Add new trainer</h3>
  <label>Name<input name="name" required placeholder="Coach Vikram"></label>
  <label>Login email<input name="email" type="email" required placeholder="trainer3@ironpulse.com"></label>
  <label>Specialization<input name="specialization" placeholder="Powerlifting & Mobility"></label>
  <label>Password<input name="password" type="password" value="password123"></label>
  <footer><button type="button" class="btn" onclick="closeModal(this)">Cancel</button><button class="btn primary">Add trainer</button></footer>
</form></dialog>

<dialog id="m-admin" class="modal"><form method="post" action="/admin/actions">
  <input type="hidden" name="action" value="add_admin"><input type="hidden" name="back" value="<%= selfUrl %>">
  <h3>Add new Administrator</h3><p class="muted">Grant team members full access to the IronPulse Admin Portal.</p>
  <label>Full name<input name="name" required placeholder="Sourav Yadav" data-testid="admin-name-input"></label>
  <label>Login email<input name="email" type="email" required placeholder="admin2@ironpulse.com" data-testid="admin-email-input"></label>
  <label>Password<input name="password" type="password" value="password123"></label>
  <footer><button type="button" class="btn" onclick="closeModal(this)">Cancel</button><button class="btn primary" data-testid="admin-form-submit-button">Add administrator</button></footer>
</form></dialog>

<dialog id="m-plan" class="modal"><form method="post" action="/admin/actions">
  <input type="hidden" name="action" value="save_plan"><input type="hidden" name="back" value="/admin?page=plans"><input type="hidden" name="plan_id" value="0">
  <h3>Membership plan</h3>
  <label>Plan name<input name="plan_name" required></label>
  <div class="grid2"><label>Price (₹)<input name="price" type="number" step="0.01" min="0" required></label><label>Duration (months)<input name="duration_months" type="number" min="1" value="12"></label></div>
  <footer><button type="button" class="btn" onclick="closeModal(this)">Cancel</button><button class="btn primary">Save plan</button></footer>
</form></dialog>

<dialog id="m-confirm" class="modal small"><form method="post" action="/admin/actions">
  <input type="hidden" name="action"><input type="hidden" name="back" value="<%= selfUrl %>">
  <input type="hidden" name="member_id"><input type="hidden" name="trainer_id"><input type="hidden" name="booking_id">
  <h3 data-title>Are you sure?</h3><p class="muted" data-desc></p>
  <footer><button type="button" class="btn" onclick="closeModal(this)">Cancel</button><button class="btn danger" data-testid="confirm-delete-button">Delete</button></footer>
</form></dialog>
