<% if (!m) { %>
  <div class="card"><p class="empty">Member not found. <a href="/admin?page=members">Back to members</a></p></div>
<% } else { %>
<a class="back" href="/admin?page=members">← All members</a>
<div class="page-head"><div class="who big"><span class="avatar"><%= initials(m.name) %></span><div><h1><%= m.name %> <%- statusBadge(m.status) %></h1>
  <p class="muted"><%= m.email %><%= m.phone ? ' · ' + m.phone : '' %> · Member #<%= m.member_id %></p></div></div>
  <div class="actions"><button class="btn" onclick="openModal('m-payment',{member_id:<%= m.member_id %>})">₹ Record payment</button><button class="btn" onclick="openModal('m-checkin',{member_id:<%= m.member_id %>})">Check in</button><button class="btn" onclick="openModal('m-slot',{member_id:<%= m.member_id %>})">Assign slot</button></div></div>

<div class="stats4">
  <div><small>Plan</small><b><%= m.plan_name || 'None' %></b></div>
  <div><small>Expiry</small><b><%= fdate(m.plan_end_date) %></b></div>
  <div><small>Days</small><b class="<%= m.overdue ? 'txt-red' : '' %>"><%= m.overdue ? Math.abs(m.days) + ' overdue' : m.days + ' left' %></b></div>
  <div><small>BMI</small><b><%= Number(m.bmi).toFixed(1) %></b></div>
</div>

<nav class="tabs">
  <% Object.entries(TABS).forEach(([k, label]) => { %>
    <a href="/admin?page=member&id=<%= m.member_id %>&tab=<%= k %>" class="<%= tab === k ? 'on' : '' %>"><%= label %></a>
  <% }) %>
</nav>

<section class="card">
<% if (tab === 'membership') { %>
  <form method="post" action="/admin/actions" class="grid3">
    <input type="hidden" name="action" value="update_membership">
    <input type="hidden" name="member_id" value="<%= m.member_id %>">
    <input type="hidden" name="back" value="/admin?page=member&id=<%= m.member_id %>&tab=membership">
    <input type="hidden" name="original_status" value="<%= m.status %>">
    <label>Plan<select name="plan_id">
      <% plans.forEach(p => { %>
        <option value="<%= p.plan_id %>" <%= p.plan_id === m.membership_plan_id ? 'selected' : '' %>><%= p.plan_name %></option>
      <% }) %>
    </select></label>
    <label>Expiry date<input type="date" name="plan_end_date" value="<%= m.plan_end_date ? m.plan_end_date.toISOString().split('T')[0] : '' %>"></label>
    <label>Status<select name="status"><option value="Active" <%= m.status === 'Active' ? 'selected' : '' %>>Active</option><option value="Inactive" <%= m.status === 'Inactive' ? 'selected' : '' %>>Inactive</option></select></label>
    <p class="muted span3">Status follows the expiry date automatically (past date → Inactive) unless you change it here yourself.</p>
    <div class="span3 right"><button class="btn primary">Save membership</button></div>
  </form>
  <% if (bk && bk.length > 0) { %><h3 class="sub">Trainer slots</h3><div class="list tight">
    <% bk.forEach(b => { %>
      <div class="row"><span class="grow"><%= b.trainer_name %></span><small class="mono"><%= b.slot_time %></small><span class="badge cyan"><%= b.locker_number %></span></div>
    <% }) %>
  </div><% } %>
  <div class="danger-zone"><b>Danger zone</b><p class="muted">Deleting removes the member with all bookings, payments, logs and workouts.</p>
    <button class="btn danger" onclick="confirmDelete('delete_member',{member_id:<%= m.member_id %>},'Delete ' + <%= JSON.stringify(m.name) %> + '?','This cannot be undone.')">Delete member</button></div>

<% } else if (tab === 'biometrics') { %>
  <p><span class="badge <%= bmiInfo(m.bmi).color %>"><%= Number(m.bmi).toFixed(1) %> · <%= bmiInfo(m.bmi).label %></span> <span class="muted"><%= Number(m.height_cm).toFixed(0) %> cm · <%= Number(m.weight_kg).toFixed(1) %> kg · body fat <%= Number(m.body_fat_pct).toFixed(1) %>%</span></p>
  <form method="post" action="/admin/actions" class="grid3">
    <input type="hidden" name="action" value="update_biometrics">
    <input type="hidden" name="member_id" value="<%= m.member_id %>">
    <input type="hidden" name="back" value="/admin?page=member&id=<%= m.member_id %>&tab=biometrics">
    <label>Height (cm)<input type="number" step="0.1" name="height_cm" value="<%= m.height_cm %>"></label>
    <label>Weight (kg)<input type="number" step="0.1" name="weight_kg" value="<%= m.weight_kg %>"></label>
    <label>Body fat (%)<input type="number" step="0.1" name="body_fat_pct" value="<%= m.body_fat_pct %>"></label>
    <label class="span3">Fitness goal<input name="fitness_goal" value="<%= m.fitness_goal %>"></label>
    <label class="span3">Coach / diet notes<textarea name="trainer_notes" rows="2"><%= m.trainer_notes %></textarea></label>
    <div class="span3 right"><button class="btn primary">Save & recalculate BMI</button></div>
  </form>

<% } else if (tab === 'payments') { %>
  <% if (!pays || pays.length === 0) { %><p class="empty">No payments recorded yet.</p><% } else { %>
  <div class="table-wrap"><table><thead><tr><th>Receipt</th><th>Amount</th><th>Date</th><th>Method</th></tr></thead><tbody>
  <% pays.forEach(p => { %><tr><td class="mono">#INV-<%= p.payment_id %></td><td class="money"><%= inr(p.amount, 2) %></td><td><%= fdate(p.payment_date) %></td><td><%= p.method %></td></tr><% }) %>
  </tbody></table></div><% } %>

<% } else if (tab === 'attendance') { %>
  <% if (!logs || logs.length === 0) { %><p class="empty">No attendance recorded yet.</p><% } else { %>
  <div class="table-wrap"><table><thead><tr><th>Login</th><th>Logout</th><th>Duration</th><th>Status</th></tr></thead><tbody>
  <% logs.forEach(l => { %><tr><td class="mono"><%= fdt(l.login_time) %></td><td class="mono"><%= l.logout_time ? fdt(l.logout_time) : '—' %></td><td><%= l.duration_minutes !== null ? l.duration_minutes + ' min' : 'In progress' %></td>
    <td><span class="badge <%= l.session_status === 'Online' ? 'green' : 'gray' %>"><%= l.session_status %></span></td></tr><% }) %>
  </tbody></table></div><% } %>

<% } else { %>
  <% if (!wk || wk.length === 0) { %><p class="empty">No workouts logged yet.</p><% } else { %>
  <div class="table-wrap"><table><thead><tr><th>Date</th><th>Exercise</th><th>Group</th><th>Sets × Reps</th><th>Weight</th><th>Coach</th></tr></thead><tbody>
  <% wk.forEach(w => { %><tr><td class="mono"><%= fdate(w.workout_date) %></td><td><b><%= w.exercise_name %></b></td><td><%= w.muscle_group %></td><td><%= w.sets %> × <%= w.reps %></td><td><%= Number(w.weight_kg).toFixed(1) %> kg</td><td><%= w.coach %></td></tr><% }) %>
  </tbody></table></div><% } %>
  <h3 class="sub">Log a new workout</h3>
  <form method="post" action="/admin/actions" class="grid6">
    <input type="hidden" name="action" value="add_workout">
    <input type="hidden" name="member_id" value="<%= m.member_id %>">
    <input type="hidden" name="back" value="/admin?page=member&id=<%= m.member_id %>&tab=progress">
    <label class="span2">Exercise<input name="exercise_name" required placeholder="Incline Dumbbell Press"></label>
    <label>Group<select name="muscle_group">
      <% MUSCLES.forEach(g => { %><option><%= g %></option><% }) %>
    </select></label>
    <label>Sets<input type="number" name="sets" value="4" min="1"></label><label>Reps<input type="number" name="reps" value="10" min="1"></label>
    <label>Weight (kg)<input type="number" step="0.5" name="weight_kg" value="40"></label>
    <input type="hidden" name="workout_date" value="<%= todayDate %>">
    <div class="span6 right"><button class="btn primary">Log workout</button></div>
  </form>
<% } %>
</section>
<% } %>
