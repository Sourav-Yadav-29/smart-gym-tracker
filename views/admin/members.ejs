<div class="page-head"><div><h1>Members & Dues</h1><p class="muted">Search, filter and manage every membership, payment and progress record.</p></div>
  <div class="actions"><a class="btn" href="/admin/export?type=members"><%- icon('download') %>Export CSV</a><button class="btn primary" onclick="openModal('m-member')"><%- icon('plus') %>Add member</button></div></div>

<form class="filters card" method="get" action="/admin"><input type="hidden" name="page" value="members">
  <input name="q" value="<%= query.q || '' %>" placeholder="Search name, email or phone" data-testid="member-search-input">
  <select name="status" onchange="this.form.submit()">
    <option value="">All statuses</option>
    <option value="Active" <%= query.status === 'Active' ? 'selected' : '' %>>Active</option>
    <option value="Inactive" <%= query.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
  </select>
  <select name="plan" onchange="this.form.submit()">
    <option value="0">All plans</option>
    <% plans.forEach(p => { %>
      <option value="<%= p.plan_id %>" <%= String(query.plan) === String(p.plan_id) ? 'selected' : '' %>><%= p.plan_name %></option>
    <% }) %>
  </select>
  <select name="expiry" onchange="this.form.submit()">
    <option value="">Any expiry</option>
    <option value="overdue" <%= query.expiry === 'overdue' ? 'selected' : '' %>>Overdue</option>
    <option value="soon" <%= query.expiry === 'soon' ? 'selected' : '' %>>Due in 30 days</option>
    <option value="ok" <%= query.expiry === 'ok' ? 'selected' : '' %>>Beyond 30 days</option>
  </select>
  <button class="btn">Apply</button><a class="btn ghost" href="/admin?page=members">Clear</a>
</form>

<section class="card flush"><div class="card-head pad"><h2><%= list.length %> of <%= members.length %> members</h2></div>
<% if (!list || list.length === 0) { %><p class="empty">No members match these filters.</p><% } else { %>
<div class="table-wrap"><table>
  <thead><tr><th>Member</th><th>Plan</th><th>Expiry</th><th>Status</th><th class="hide-md">BMI</th><th class="right">Actions</th></tr></thead>
  <tbody>
    <% list.forEach(m => { %>
    <tr><td><a class="who" href="/admin?page=member&id=<%= m.member_id %>"><span class="avatar sm"><%= initials(m.name) %></span><span><b><%= m.name %></b><small><%= m.email %></small></span></a></td>
      <td><span class="pill"><%= m.plan_name || 'None' %></span></td>
      <td><span class="mono"><%= fdate(m.plan_end_date) %></span><small class="<%= m.overdue ? 'txt-red' : (m.days <= 30 ? 'txt-amber' : '') %>"><%= m.overdue ? Math.abs(m.days) + 'd overdue' : m.days + 'd left' %></small></td>
      <td><%- statusBadge(m.status) %></td>
      <td class="hide-md"><span class="badge <%= bmiInfo(m.bmi).color %>"><%= Number(m.bmi).toFixed(1) %> · <%= bmiInfo(m.bmi).label %></span></td>
      <td class="right nowrap">
        <a class="btn xs" href="/admin?page=member&id=<%= m.member_id %>">View</a>
        <button class="btn xs" onclick="openModal('m-payment', { member_id: <%= m.member_id %> })">₹ Pay</button>
        <form method="post" action="/admin/actions" class="inline"><input type="hidden" name="action" value="send_reminder"><input type="hidden" name="member_id" value="<%= m.member_id %>"><input type="hidden" name="back" value="<%= selfUrl %>"><button class="btn xs">Remind</button></form>
        <button class="btn xs danger-ghost" onclick="confirmDelete('delete_member', { member_id: <%= m.member_id %> }, 'Delete ' + <%= JSON.stringify(m.name) %> + '?', 'Removes the member with bookings, payments, logs and workouts.')">Delete</button>
      </td></tr>
    <% }) %>
  </tbody></table></div>
<% } %></section>
