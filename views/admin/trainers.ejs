<div class="page-head"><div><h1>Trainers & Slots</h1><p class="muted">Coach capacity, specialties and every client–trainer slot assignment.</p></div>
  <div class="actions"><button class="btn" onclick="openModal('m-slot')">Assign slot</button><button class="btn primary" onclick="openModal('m-trainer')"><%- icon('plus') %>Add trainer</button></div></div>

<div class="cards4">
<% if (!trainers || trainers.length === 0) { %><p class="empty">No trainers yet — add your first coach.</p><% } %>
<% trainers.forEach(t => { 
    const n = Number(t.assigned_count) || 0; 
    const pct = Math.min(100, Math.round(n / TRAINER_CAPACITY * 100)); 
%>
  <div class="card lift">
    <div class="who"><span class="avatar"><%= initials(t.name) %></span><span class="grow"><b><%= t.name %></b><small><%= t.email %></small></span>
      <button class="btn xs danger-ghost" onclick="confirmDelete('delete_trainer',{trainer_id:<%= t.trainer_id %>},'Remove ' + <%= JSON.stringify(t.name) %> + '?','Their slot bookings will be released.')">Remove</button></div>
    <span class="badge violet"><%= t.specialization %></span>
    <div class="meter"><div><small>Slot utilization</small><small class="mono"><%= n %>/<%= TRAINER_CAPACITY %></small></div><span><i style="width:<%= pct %>%"></i></span></div>
    <button class="btn block" onclick="openModal('m-slot',{trainer_id:<%= t.trainer_id %>})">Assign client</button>
  </div>
<% }) %>
</div>

<section class="card flush"><div class="card-head pad"><h2>Active trainer–client slot bookings</h2></div>
<% if (!bookings || bookings.length === 0) { %><p class="empty">No slot bookings yet.</p><% } else { %>
<div class="table-wrap"><table><thead><tr><th>Member</th><th>Trainer</th><th>Slot time</th><th>Locker</th><th class="right">Cancel</th></tr></thead><tbody>
<% bookings.forEach(b => { %><tr><td><b><%= b.member_name %></b></td><td><%= b.trainer_name %> <small class="inline">· <%= b.specialization %></small></td><td class="mono"><%= b.slot_time %></td><td><span class="badge cyan"><%= b.locker_number %></span></td>
  <td class="right"><button class="btn xs danger-ghost" onclick="confirmDelete('delete_booking',{booking_id:<%= b.booking_id %>},'Cancel this slot?', 'Booking for ' + <%= JSON.stringify(b.member_name + ' with ' + b.trainer_name) %>)">Cancel</button></td></tr><% }) %>
</tbody></table></div><% } %></section>
