<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IronPulse — <%= role.toUpperCase() %> Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Outfit:wght@700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-canvas: #090C10;
            --bg-surface: #11161F;
            --bg-elevated: #171E2B;
            --text-primary: #F3F6FA;
            --text-secondary: #94A3B8;
            --text-muted: #64748B;
            --accent-lime: #CCFF00;
            --accent-lime-dim: rgba(204, 255, 0, 0.12);
            --accent-cyan: #00F0FF;
            --accent-emerald: #10B981;
            --accent-amber: #F59E0B;
            --accent-danger: #EF4444;
            --accent-purple: #A855F7;
            --border-subtle: rgba(255, 255, 255, 0.08);
            --radius-md: 12px;
            --radius-lg: 16px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background-color: var(--bg-canvas);
            background-image:
                radial-gradient(circle at 10% 10%, rgba(204, 255, 0, 0.05), transparent 35%),
                radial-gradient(circle at 90% 15%, rgba(0, 240, 255, 0.05), transparent 35%);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
        }

        .sidebar {
            width: 276px;
            background: var(--bg-surface);
            border-right: 1px solid var(--border-subtle);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 24px 16px;
            position: fixed;
            top: 0; bottom: 0; left: 0;
            z-index: 50;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 10px 20px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .brand-logo {
            width: 40px; height: 40px;
            border-radius: 10px;
            background: var(--accent-lime);
            color: #090C10;
            display: grid;
            place-items: center;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 1.15rem;
            box-shadow: 0 0 20px rgba(204, 255, 0, 0.3);
        }

        .brand-text h1 { font-family: 'Space Grotesk', sans-serif; font-size: 1.08rem; letter-spacing: -0.02em; }
        .brand-text span { font-size: 0.7rem; color: var(--accent-lime); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }

        .rbac-shield {
            margin: 16px 6px 8px;
            padding: 10px 12px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-subtle);
            font-size: 0.75rem;
        }

        .rbac-shield strong { display: block; color: var(--accent-cyan); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 2px; }

        .nav-menu { list-style: none; margin-top: 10px; display: flex; flex-direction: column; gap: 6px; }

        .nav-btn {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 11px 14px;
            border-radius: var(--radius-md);
            border: 1px solid transparent;
            background: transparent;
            color: var(--text-secondary);
            font-size: 0.88rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.16s ease;
            text-align: left;
        }

        .nav-btn-left { display: flex; align-items: center; gap: 11px; }
        .nav-btn:hover { background: rgba(255, 255, 255, 0.04); color: var(--text-primary); }
        .nav-btn.active {
            background: var(--accent-lime-dim);
            color: var(--accent-lime);
            border-color: rgba(204, 255, 0, 0.28);
            font-weight: 600;
        }

        .nav-pill {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            padding: 2px 7px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.06);
            color: var(--text-secondary);
        }

        .user-footer {
            padding: 14px;
            background: var(--bg-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
        }

        .user-info { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
        .avatar {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #CCFF00, #00F0FF);
            color: #090C10;
            display: grid;
            place-items: center;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .user-meta p { font-size: 0.86rem; font-weight: 600; }
        .user-meta small { font-size: 0.72rem; color: var(--accent-emerald); text-transform: uppercase; }

        .logout-btn {
            display: block;
            width: 100%;
            text-align: center;
            padding: 8px 12px;
            border-radius: 8px;
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #FCA5A5;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 600;
            transition: 0.15s;
        }
        .logout-btn:hover { background: rgba(239, 68, 68, 0.22); }

        .main-content {
            margin-left: 276px;
            flex: 1;
            padding: 34px 42px;
            max-width: 1480px;
        }

        /* Topbar with Multi-Tone Greeting on Left & Notification Bell on Right */
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 34px;
            padding-bottom: 6px;
            gap: 20px;
        }

        .hero-greeting {
            font-family: 'Outfit', 'Space Grotesk', sans-serif;
            font-size: clamp(2.35rem, 3.6vw, 3.15rem);
            font-weight: 800;
            letter-spacing: -0.035em;
            line-height: 1.12;
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 0.28em;
        }

        .hero-greeting .word-welcome { color: #F8FAFC; }
        .hero-greeting .word-back {
            background: linear-gradient(135deg, #94A3B8 0%, #38BDF8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-greeting .word-name {
            background: linear-gradient(95deg, #CCFF00 0%, #10B981 48%, #00F0FF 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 24px rgba(204, 255, 0, 0.18));
        }
        .hero-greeting .word-dot { color: #CCFF00; }

        /* Top-Right Notification Center */
        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 14px;
            position: relative;
        }

        .notif-bell-btn {
            position: relative;
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            color: var(--text-primary);
            display: grid;
            place-items: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .notif-bell-btn:hover {
            border-color: var(--accent-lime);
            background: var(--bg-elevated);
            transform: translateY(-1px);
        }

        .notif-bell-btn.pulse-ring {
            animation: bellPulse 1.2s ease-out 2;
            border-color: var(--accent-lime);
        }

        @keyframes bellPulse {
            0% { box-shadow: 0 0 0 0 rgba(204, 255, 0, 0.55); }
            70% { box-shadow: 0 0 0 14px rgba(204, 255, 0, 0); }
            100% { box-shadow: 0 0 0 0 rgba(204, 255, 0, 0); }
        }

        .notif-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            min-width: 21px;
            height: 21px;
            padding: 0 6px;
            border-radius: 999px;
            background: var(--accent-lime);
            color: #090C10;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 12px rgba(204, 255, 0, 0.5);
        }

        .notif-drawer {
            position: absolute;
            top: 58px;
            right: 0;
            width: 400px;
            max-height: 480px;
            background: rgba(17, 22, 31, 0.97);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 16px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);
            z-index: 200;
            display: none;
            flex-direction: column;
            overflow: hidden;
        }

        .notif-drawer.open {
            display: flex;
            animation: fadeIn 0.18s ease;
        }

        .notif-drawer-header {
            padding: 16px 18px;
            border-bottom: 1px solid var(--border-subtle);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--bg-elevated);
        }

        .notif-drawer-header h4 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
        }

        .notif-drawer-actions {
            display: flex;
            gap: 10px;
        }

        .notif-action-link {
            background: none;
            border: none;
            color: var(--accent-cyan);
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
        }

        .notif-action-link:hover { text-decoration: underline; }

        .notif-list {
            overflow-y: auto;
            max-height: 390px;
            divide-y: 1px solid var(--border-subtle);
        }

        .notif-item {
            padding: 14px 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            transition: background 0.15s;
        }

        .notif-item.unread {
            background: rgba(204, 255, 0, 0.05);
            border-left: 3px solid var(--accent-lime);
        }

        .notif-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 5px;
            font-size: 0.72rem;
        }

        .notif-cat {
            font-weight: 700;
            color: var(--accent-lime);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .notif-time {
            color: var(--text-muted);
            font-family: 'JetBrains Mono', monospace;
        }

        .notif-msg {
            font-size: 0.84rem;
            color: var(--text-primary);
            line-height: 1.45;
        }

        /* Upcoming Dues Banner & Cycle Selector Cards */
        .dues-banner {
            background: linear-gradient(90deg, rgba(204, 255, 0, 0.1), rgba(0, 240, 255, 0.06));
            border: 1px solid rgba(204, 255, 0, 0.35);
            border-radius: var(--radius-lg);
            padding: 20px 24px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
        }

        .dues-banner.overdue {
            background: linear-gradient(90deg, rgba(239, 68, 68, 0.15), rgba(245, 158, 11, 0.08));
            border-color: rgba(239, 68, 68, 0.45);
        }

        .cycle-selector-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-bottom: 14px;
        }

        .cycle-option {
            background: var(--bg-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: 10px;
            padding: 12px;
            cursor: pointer;
            transition: all 0.15s ease;
            text-align: left;
        }

        .cycle-option.selected {
            border-color: var(--accent-lime);
            background: var(--accent-lime-dim);
        }

        .cycle-option strong {
            display: block;
            font-size: 0.86rem;
            color: var(--text-primary);
        }

        .cycle-option span {
            font-size: 0.74rem;
            color: var(--accent-cyan);
        }

        .trigger-callout {
            background: linear-gradient(90deg, rgba(245, 158, 11, 0.12), rgba(23, 30, 43, 0.9));
            border: 1px solid rgba(245, 158, 11, 0.4);
            border-radius: var(--radius-lg);
            padding: 18px 22px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .trigger-callout h4 { font-family: 'Space Grotesk', sans-serif; color: var(--accent-amber); font-size: 1rem; margin-bottom: 4px; }
        .trigger-callout p { font-size: 0.84rem; color: var(--text-secondary); }

        .tab-panel { display: none; animation: fadeIn 0.2s ease; }
        .tab-panel.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

        .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 24px; }
        .kpi-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            padding: 20px;
            position: relative;
            overflow: hidden;
        }
        .kpi-card::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--accent-lime); }
        .kpi-card.cyan::after { background: var(--accent-cyan); }
        .kpi-card.emerald::after { background: var(--accent-emerald); }
        .kpi-card.purple::after { background: var(--accent-purple); }

        .kpi-label { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-secondary); font-weight: 600; }
        .kpi-value { font-family: 'Space Grotesk', sans-serif; font-size: 1.9rem; font-weight: 700; margin: 10px 0 6px; font-variant-numeric: tabular-nums; }
        .kpi-sub { font-size: 0.78rem; color: var(--text-muted); }

        .form-table-grid { display: grid; grid-template-columns: 365px 1fr; gap: 24px; align-items: start; }
        .bento-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }

        .card {
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            padding: 22px;
            margin-bottom: 20px;
        }

        .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; gap: 12px; flex-wrap: wrap; }
        .card-title { font-family: 'Space Grotesk', sans-serif; font-size: 1.08rem; font-weight: 600; }

        .form-group { margin-bottom: 14px; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        label { display: block; font-size: 0.76rem; color: var(--text-secondary); margin-bottom: 6px; font-weight: 500; }
        input, select {
            width: 100%;
            padding: 10px 12px;
            background: var(--bg-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 0.88rem;
            font-family: 'Inter', sans-serif;
            outline: none;
        }
        input:focus, select:focus { border-color: var(--accent-lime); }

        .btn-primary {
            width: 100%;
            padding: 11px 16px;
            background: var(--accent-lime);
            color: #090C10;
            font-weight: 700;
            font-size: 0.88rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.15s;
        }
        .btn-primary:hover { box-shadow: 0 0 20px rgba(204, 255, 0, 0.28); }

        .btn-secondary {
            padding: 8px 14px;
            background: var(--bg-elevated);
            color: var(--text-primary);
            border: 1px solid var(--border-subtle);
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-amber {
            padding: 9px 15px;
            background: var(--accent-amber);
            color: #090C10;
            border: none;
            border-radius: 8px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
        }

        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); padding: 12px 13px; border-bottom: 1px solid var(--border-subtle); }
        td { padding: 13px; font-size: 0.85rem; border-bottom: 1px solid rgba(255, 255, 255, 0.04); font-variant-numeric: tabular-nums; vertical-align: middle; }

        .badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 0.72rem; font-weight: 600; }
        .badge-active { background: rgba(16, 185, 129, 0.14); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.3); }
        .badge-inactive { background: rgba(239, 68, 68, 0.14); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.3); }
        .badge-amber { background: rgba(245, 158, 11, 0.15); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.35); }
        .badge-lime { background: rgba(204, 255, 0, 0.12); color: var(--accent-lime); }
        .badge-cyan { background: rgba(0, 240, 255, 0.12); color: var(--accent-cyan); }
        .badge-purple { background: rgba(168, 85, 247, 0.14); color: #C084FC; }

        .btn-delete {
            background: transparent;
            border: 1px solid rgba(239, 68, 68, 0.35);
            color: var(--accent-danger);
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 0.74rem;
            cursor: pointer;
        }

        .inline-update { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .inline-update input, .inline-update select { padding: 5px 8px; font-size: 0.78rem; width: auto; }
        .btn-mini {
            padding: 5px 10px;
            background: rgba(0, 240, 255, 0.14);
            border: 1px solid rgba(0, 240, 255, 0.35);
            color: var(--accent-cyan);
            border-radius: 6px;
            font-size: 0.74rem;
            font-weight: 600;
            cursor: pointer;
        }

        @media (max-width: 1100px) {
            .kpi-grid { grid-template-columns: repeat(2, 1fr); }
            .form-table-grid, .bento-two-col { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div>
            <div class="brand">
                <div class="brand-logo">IP</div>
                <div class="brand-text">
                    <h1>IRONPULSE</h1>
                    <span><%= role.toUpperCase() %> PORTAL</span>
                </div>
            </div>

            <div class="rbac-shield">
                <strong>🔒 RBAC Policy: <%= role.toUpperCase() %></strong>
                <% if (role === 'admin') { %>
                    <span style="color:var(--text-secondary);">Full Superuser Access (Trainers, Members, Financials & Logs)</span>
                <% } else if (role === 'trainer') { %>
                    <span style="color:var(--text-secondary);">Scoped to Assigned Clients Only (Financials Concealed)</span>
                <% } else { %>
                    <span style="color:var(--text-secondary);">Personal Member Access & Self-Service Billing</span>
                <% } %>
            </div>

            <ul class="nav-menu">
                <% if (role === 'admin') { %>
                    <li>
                        <button class="nav-btn <%= active_tab === 'overview' ? 'active' : '' %>" onclick="switchTab('overview', this)">
                            <span class="nav-btn-left"><span>⚡</span> Admin Command</span>
                        </button>
                    </li>
                    <li>
                        <button class="nav-btn <%= active_tab === 'members' ? 'active' : '' %>" onclick="switchTab('members', this)">
                            <span class="nav-btn-left"><span>👥</span> Members & Dues</span>
                            <span class="nav-pill"><%= (members ? members.length : 0) %></span>
                        </button>
                    </li>
                    <li>
                        <button class="nav-btn <%= active_tab === 'trainers' ? 'active' : '' %>" onclick="switchTab('trainers', this)">
                            <span class="nav-btn-left"><span>🏋️</span> Trainers & Slots</span>
                            <span class="nav-pill"><%= (trainers ? trainers.length : 0) %></span>
                        </button>
                    </li>
                    <li>
                        <button class="nav-btn <%= active_tab === 'attendance' ? 'active' : '' %>" onclick="switchTab('attendance', this)">
                            <span class="nav-btn-left"><span>🕒</span> Login/Logout Logs</span>
                            <span class="nav-pill"><%= (access_logs ? access_logs.length : 0) %></span>
                        </button>
                    </li>
                    <li>
                        <button class="nav-btn <%= active_tab === 'financials' ? 'active' : '' %>" onclick="switchTab('financials', this)">
                            <span class="nav-btn-left"><span>💳</span> Plans & Revenue</span>
                            <span class="nav-pill"><%= (payments ? payments.length : 0) %></span>
                        </button>
                    </li>

                <% } else if (role === 'trainer') { %>
                    <li>
                        <button class="nav-btn <%= active_tab === 'overview' ? 'active' : '' %>" onclick="switchTab('overview', this)">
                            <span class="nav-btn-left"><span>⚡</span> My Clients Roster</span>
                            <span class="nav-pill"><%= (members ? members.length : 0) %></span>
                        </button>
                    </li>
                    <li>
                        <button class="nav-btn <%= active_tab === 'biometrics' ? 'active' : '' %>" onclick="switchTab('biometrics', this)">
                            <span class="nav-btn-left"><span>📊</span> Client BMI & Metrics</span>
                        </button>
                    </li>
                    

                <% } else { %>
                    <li>
                        <button class="nav-btn <%= active_tab === 'overview' ? 'active' : '' %>" onclick="switchTab('overview', this)">
                            <span class="nav-btn-left"><span>⚡</span> My Fitness Hub</span>
                        </button>
                    </li>
                    <li>
                        <button class="nav-btn <%= active_tab === 'my_bmi' ? 'active' : '' %>" onclick="switchTab('my_bmi', this)">
                            <span class="nav-btn-left"><span>📊</span> My BMI & Workouts</span>
                        </button>
                    </li>
                    <li>
                        <button class="nav-btn <%= active_tab === 'my_schedule' ? 'active' : '' %>" onclick="switchTab('my_schedule', this)">
                            <span class="nav-btn-left"><span>🔐</span> My Slot & Locker</span>
                            <span class="nav-pill"><%= (bookings ? bookings.length : 0) %></span>
                        </button>
                    </li>
                    <li>
                        <button class="nav-btn <%= active_tab === 'my_billing' ? 'active' : '' %>" onclick="switchTab('my_billing', this)">
                            <span class="nav-btn-left"><span>💳</span> Upcoming Dues & Pay</span>
                            <span class="nav-pill"><%= (payments ? payments.length : 0) %></span>
                        </button>
                    </li>
                <% } %>
            </ul>
        </div>

        <div class="user-footer">
            <div class="user-info">
                <div class="avatar"><%= initials(actor_name) %></div>
                <div class="user-meta">
                    <p><%= actor_name %></p>
                    <small>● <%= role %> (#<%= actor_id %>)</small>
                </div>
            </div>
            <a href="/logout" class="logout-btn">Sign Out →</a>
        </div>
    </aside>

    <main class="main-content">
        <!-- REDESIGNED HERO HEADER + TOP-RIGHT NOTIFICATION BELL -->
        <header class="topbar">
            <h2 class="hero-greeting">
                <span class="word-welcome">Welcome</span>
                <span class="word-back">back,</span>
                <span class="word-name"><%= actor_name %></span><span class="word-dot">.</span>
            </h2>

            <div class="topbar-actions">
                <% if (role === 'member') { %>
                    <button class="btn-secondary" onclick="switchTab('my_billing')" style="border-color:rgba(204,255,0,0.35);color:var(--accent-lime);">
                        💳 Pay Upcoming Dues
                    </button>
                <% } %>

                <button id="notifBellBtn" class="notif-bell-btn <%= locals.notif_pulse ? 'pulse-ring' : '' %>" onclick="toggleNotifDrawer(event)" title="Activity & Notifications">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span id="notifBadge" class="notif-badge" style="<%= unread_count === 0 ? 'display:none;' : '' %>"><%= unread_count %></span>
                </button>

                <!-- Slide-Down Notification Center Drawer -->
                <div id="notifDrawer" class="notif-drawer" onclick="event.stopPropagation()">
                    <div class="notif-drawer-header">
                        <h4>Notifications & Activity Log</h4>
                        <div class="notif-drawer-actions">
                            <button class="notif-action-link" onclick="markAllNotificationsRead()">Mark all read</button>
                            <button class="notif-action-link" style="color:var(--text-muted);" onclick="clearAllNotifications()">Clear</button>
                        </div>
                    </div>
                    <div id="notifListContainer" class="notif-list">
                        <% if ((!notifications || notifications.length === 0)) { %>
                            <div style="padding:28px 18px;text-align:center;color:var(--text-muted);font-size:0.84rem;">
                                No notifications yet. All updates, BMI changes, and payment confirmations appear here automatically.
                            </div>
                        <% } else { %>
                            <% (notifications || []).forEach(n => { %>
                                <div class="notif-item <%= n['is_read'] === 0 ? 'unread' : '' %>">
                                    <div class="notif-meta">
                                        <span class="notif-cat"><%= n['category'] %> · <%= n['actor_name'] %></span>
                                        <span class="notif-time"><%= fdt(n['created_at']) %></span>
                                    </div>
                                    <div class="notif-msg"><%= n['message'] %></div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>
        </header>

        <% if (role === 'admin') { %>
            <!-- =========================================================================
                 ADMIN VIEW: FULL CONTROL OF TRAINERS, MEMBERS, LOGS, TRIGGER & FINANCIALS
                 ========================================================================= -->
            <section id="tab-overview" class="tab-panel <%= active_tab === 'overview' ? 'active' : '' %>">
                <div class="trigger-callout">
                    <div>
                        <h4>⚡ MySQL Trigger Control: <code>trg_check_membership_expiry</code></h4>
                        <p>
                            <% if (expired_but_active_count > 0) { %>
                                <strong><%= expired_but_active_count %> member(s)</strong> have <code>plan_end_date &lt; CURDATE()</code> but are still marked <strong>Active</strong>. Click below to run the MySQL trigger audit.
                            <% } else { %>
                                All expired accounts are marked <strong>Inactive</strong>. Use <strong>Reset Sarah Demo</strong> to test the trigger again.
                            <% } %>
                        </p>
                    </div>
                    <div style="display:flex;gap:10px;">
                        <form method="POST" action="/dashboard">
                            <input type="hidden" name="action" value="run_trigger_audit">
                            <input type="hidden" name="return_tab" value="overview">
                            <button type="submit" class="btn-amber">▶ Fire Expiry Trigger</button>
                        </form>
                        <form method="POST" action="/dashboard">
                            <input type="hidden" name="action" value="reset_trigger_demo">
                            <input type="hidden" name="return_tab" value="overview">
                            <button type="submit" class="btn-secondary">↺ Reset Sarah Demo</button>
                        </form>
                    </div>
                </div>

                <div class="kpi-grid">
                    <div class="kpi-card">
                        <div class="kpi-label">Total Gym Revenue</div>
                        <div class="kpi-value">₹<%= Number(total_revenue).toFixed(0) %></div>
                        <div class="kpi-sub"><%= (payments ? payments.length : 0) %> verified payments</div>
                    </div>
                    <div class="kpi-card emerald">
                        <div class="kpi-label">Active Members</div>
                        <div class="kpi-value"><%= active_members_count %> <span style="font-size:1rem;color:var(--text-secondary)">/ <%= (members ? members.length : 0) %></span></div>
                        <div class="kpi-sub"><%= inactive_members_count %> Inactive accounts</div>
                    </div>
                    <div class="kpi-card cyan">
                        <div class="kpi-label">Certified Trainers</div>
                        <div class="kpi-value"><%= (trainers ? trainers.length : 0) %></div>
                        <div class="kpi-sub"><%= (bookings ? bookings.length : 0) %> active slot assignments</div>
                    </div>
                    <div class="kpi-card purple">
                        <div class="kpi-label">Admin Access Logs</div>
                        <div class="kpi-value"><%= (access_logs ? access_logs.length : 0) %></div>
                        <div class="kpi-sub">Login/Logout events tracked</div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Complete Member Overview (Status, BMI, Expiry & Payment Reminders)</span>
                        <button class="btn-secondary" onclick="switchTab('members')">Manage Members →</button>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Member</th>
                                    <th>Plan</th>
                                    <th>Expiry Date</th>
                                    <th>Status</th>
                                    <th>BMI</th>
                                    <th>Due Reminder</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% (members || []).forEach(m => { const bmi_info = bmiInfo(m.bmi); const bmi_label = bmi_info.label; const bmi_cls = bmi_info.color; %>
                                    <tr>
                                        <td>#<%= m['member_id'] %></td>
                                        <td style="font-weight:600;"><%= m['name'] %><br><small style="color:var(--text-muted);"><%= m['email'] %></small></td>
                                        <td><span class="badge badge-lime"><%= m['plan_name'] ?? 'None' %></span></td>
                                        <td><%= m['plan_end_date'] %></td>
                                        <td><span class="badge <%= m['status'] === 'Active' ? 'badge-active' : 'badge-inactive' %>"><%= m['status'] %></span></td>
                                        <td><span class="badge <%= bmi_cls %>"><%= Number(m['bmi']).toFixed(1) %> (<%= bmi_label %>)</span></td>
                                        <td>
                                            <form method="POST" action="/dashboard">
                                                <input type="hidden" name="action" value="send_due_reminder">
                                                <input type="hidden" name="member_id" value="<%= m['member_id'] %>">
                                                <input type="hidden" name="member_name" value="<%= m['name'] %>">
                                                <input type="hidden" name="plan_end_date" value="<%= m['plan_end_date'] %>">
                                                <button type="submit" class="btn-mini">🔔 Send Due Alert</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section id="tab-members" class="tab-panel <%= active_tab === 'members' ? 'active' : '' %>">
                <div class="form-table-grid">
                    <div class="card">
                        <div class="card-header"><span class="card-title">Enroll New Member</span></div>
                        <form method="POST" action="/dashboard?tab=members">
                            <input type="hidden" name="action" value="add_member">
                            <div class="form-group">
                                <label>Full Name</label>
                                <input type="text" name="name" placeholder="Rohan Verma" required>
                            </div>
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" name="email" placeholder="member4@ironpulse.com" required>
                            </div>
                            <div class="form-group">
                                <label>Phone</label>
                                <input type="text" name="phone" placeholder="+91 9876543219" required>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Height (cm)</label>
                                    <input type="number" step="0.1" name="height_cm" value="178" required>
                                </div>
                                <div class="form-group">
                                    <label>Weight (kg)</label>
                                    <input type="number" step="0.1" name="weight_kg" value="76" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Membership Plan</label>
                                <select name="membership_plan_id">
                                    <% (plans || []).forEach(pl => { const monthly_rate = Math.Math.round(Number(Number(pl.price)) / Math.max(1, Number(pl.duration_months))); %>
                                        <option value="<%= pl['plan_id'] %>" data-monthly="<%= monthly_rate %>" <%= (my_profile['membership_plan_id'] ?? 1) === pl['plan_id'] ? 'selected' : '' %>>
                                            <%= pl['plan_name'] %> (Base: ₹<%= Number(monthly_rate).toFixed(0) %>/mo)
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <label>2. Select Billing Frequency (Monthly / Quarterly / Annual)</label>
                            <div class="cycle-selector-grid">
                                <div class="cycle-option" onclick="selectBillingCycle(1, this)">
                                    <strong>Monthly</strong>
                                    <span>1 Month · Standard</span>
                                </div>
                                <div class="cycle-option selected" onclick="selectBillingCycle(3, this)">
                                    <strong>Quarterly</strong>
                                    <span>3 Months · Save 5%</span>
                                </div>
                                <div class="cycle-option" onclick="selectBillingCycle(6, this)">
                                    <strong>Half-Yearly</strong>
                                    <span>6 Months · Save 10%</span>
                                </div>
                                <div class="cycle-option" onclick="selectBillingCycle(12, this)">
                                    <strong>Annual VIP</strong>
                                    <span>12 Months · Save 15%</span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label>3. Payment Mode</label>
                                <select name="method">
                                    <option value="UPI / QR Instant">UPI / QR Instant (GPay / PhonePe)</option>
                                    <option value="Credit Card">Credit Card</option>
                                    <option value="Debit Card">Debit Card</option>
                                    <option value="NetBanking">NetBanking</option>
                                </select>
                            </div>

                            <div style="padding:14px;background:var(--bg-elevated);border:1px solid var(--border-subtle);border-radius:10px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;">
                                <div>
                                    <div style="font-size:0.75rem;color:var(--text-secondary);">Total Payable Now</div>
                                    <small id="cycleSubtext" style="color:var(--accent-emerald);">Extends membership by +3 Months</small>
                                </div>
                                <strong id="payablePreview" style="font-family:'JetBrains Mono',monospace;font-size:1.45rem;color:var(--accent-lime);">₹3,563</strong>
                            </div>

                            <button type="submit" class="btn-primary">⚡ Pay Dues & Extend Membership</button>
                        </form>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <span class="card-title">My Membership Payment Receipts</span>
                            <span class="badge badge-active">Valid Until: <%= my_profile['plan_end_date'] %></span>
                        </div>
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Receipt #</th>
                                        <th>Amount Paid</th>
                                        <th>Payment Date</th>
                                        <th>Payment Mode</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if ((!payments || payments.length === 0)) { %>
                                        <tr><td colspan="5" style="text-align:center;color:var(--text-muted);">No payments recorded yet.</td></tr>
                                    <% } else { %>
                                        <% (payments || []).forEach(p => { %>
                                            <tr>
                                                <td style="font-family:'JetBrains Mono',monospace;">#INV-<%= p['payment_id'] %></td>
                                                <td style="color:var(--accent-lime);font-weight:700;">₹<%= Number(p['amount']).toFixed(2) %></td>
                                                <td style="font-family:'JetBrains Mono',monospace;"><%= p['payment_date'] %></td>
                                                <td><span class="badge badge-cyan"><%= p['method'] %></span></td>
                                                <td><span class="badge badge-active">✓ Paid</span></td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>
        <% } else if (role === 'trainer') { %>
            <!-- =========================================================================
                 TRAINER VIEW: ASSIGNED CLIENTS ROSTER, BMI & WORKOUTS
                 ========================================================================= -->
            <section id="tab-overview" class="tab-panel <%= active_tab === 'overview' ? 'active' : '' %>">
                <div class="kpi-grid">
                    <div class="kpi-card">
                        <div class="kpi-label">My Assigned Clients</div>
                        <div class="kpi-value"><%= members.length %></div>
                        <div class="kpi-sub">Scoped via Trainer_Assigned_View</div>
                    </div>
                    <div class="kpi-card emerald">
                        <div class="kpi-label">Average Client BMI</div>
                        <div class="kpi-value"><%= avg_bmi %></div>
                        <div class="kpi-sub">Monitored across assigned roster</div>
                    </div>
                    <div class="kpi-card cyan">
                        <div class="kpi-label">Prescribed Workouts</div>
                        <div class="kpi-value"><%= workouts.length %></div>
                        <div class="kpi-sub">Active hypertrophy & HIIT sets</div>
                    </div>
                    <div class="kpi-card purple">
                        <div class="kpi-label">Financial Isolation</div>
                        <div class="kpi-value">Enforced</div>
                        <div class="kpi-sub">Payment tables hidden for privacy</div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Assigned Clients</span>
                        <button class="btn-secondary" onclick="switchTab('biometrics')">Update Client BMI / Notes →</button>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Client</th>
                                    <th>Membership</th>
                                    <th>Assigned Slot & Locker</th>
                                    <th>Height / Weight</th>
                                    <th>Client BMI & Body Fat</th>
                                    <th>Fitness Goal & Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!members || members.length === 0) { %>
                                    <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:24px;">No clients currently assigned to your trainer ID.</td></tr>
                                <% } else { %>
                                    <% members.forEach(c => { 
                                        const bInfo = bmiInfo(Number(c.bmi) || 24.5);
                                    %>
                                        <tr>
                                            <td>
                                                <strong><%= c.member_name %></strong><br>
                                                <small style="color:var(--text-secondary);"><%= c.member_phone || c.member_email %></small>
                                            </td>
                                            <td>
                                                <%- statusBadge(c.member_status) %>
                                            </td>
                                            <td>
                                                <div style="font-family:'JetBrains Mono',monospace;font-size:0.8rem;"><%= c.slot_time %></div>
                                                <span class="badge badge-cyan"><%= c.locker_number %></span>
                                            </td>
                                            <td><%= Number(c.height_cm).toFixed(0) %> cm / <%= Number(c.weight_kg).toFixed(1) %> kg</td>
                                            <td>
                                                <span class="badge <%= bInfo.color %>">BMI: <%= Number(c.bmi).toFixed(1) %> (<%= bInfo.label %>)</span>
                                                <div style="font-size:0.74rem;color:var(--text-muted);margin-top:3px;">Body Fat: <%= Number(c.body_fat_pct).toFixed(1) %>%</div>
                                            </td>
                                            <td>
                                                <strong style="color:var(--accent-lime);font-size:0.8rem;"><%= c.fitness_goal %></strong>
                                                <div style="font-size:0.76rem;color:var(--text-secondary);"><%= c.trainer_notes %></div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section id="tab-biometrics" class="tab-panel <%= active_tab === 'biometrics' ? 'active' : '' %>">
                <div class="form-table-grid">
                    <div class="card">
                        <div class="card-header"><span class="card-title">Update Client's BMI & Metrics</span></div>
                        <form method="POST" action="/dashboard">
                            <input type="hidden" name="action" value="update_biometrics">
                            <input type="hidden" name="return_tab" value="biometrics">
                            <div class="form-group">
                                <label>Select Client</label>
                                <select name="member_id" required>
                                    <% (members || []).forEach(c => { %>
                                        <option value="<%= c.member_id %>">
                                            <%= c.member_name %> (Current BMI: <%= Number(c.bmi).toFixed(1) %>)
                                        </option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Height (cm)</label>
                                    <input type="number" step="0.1" name="height_cm" value="180" required>
                                </div>
                                <div class="form-group">
                                    <label>Weight (kg)</label>
                                    <input type="number" step="0.1" name="weight_kg" value="82" required>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Body Fat (%)</label>
                                    <input type="number" step="0.1" name="body_fat_pct" value="14.5" required>
                                </div>
                                <div class="form-group">
                                    <label>Primary Goal</label>
                                    <input type="text" name="fitness_goal" value="Strength & Hypertrophy" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Coach Assessment & Diet Notes</label>
                                <input type="text" name="trainer_notes" placeholder="Hit 170g protein/day; increase incline press load by 2.5kg." required>
                            </div>
                            <button type="submit" class="btn-primary">Save Client Biometrics & Recalculate BMI</button>
                        </form>
                    </div>

                    <div class="card">
                        <div class="card-header"><span class="card-title">Client Biometric & Coaching Notes Breakdown</span></div>
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Client</th>
                                        <th>Height</th>
                                        <th>Weight</th>
                                        <th>BMI Score</th>
                                        <th>Body Fat %</th>
                                        <th>Goal & Coach Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!members || members.length === 0) { %>
                                        <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:24px;">No assigned clients found.</td></tr>
                                    <% } else { %>
                                        <% members.forEach(c => { 
                                            const bInfo = bmiInfo(Number(c.bmi) || 24.5);
                                        %>
                                            <tr>
                                                <td style="font-weight:600;"><%= c.member_name %></td>
                                                <td><%= Number(c.height_cm).toFixed(1) %> cm</td>
                                                <td><%= Number(c.weight_kg).toFixed(1) %> kg</td>
                                                <td><span class="badge <%= bInfo.color %>"><%= Number(c.bmi).toFixed(1) %> — <%= bInfo.label %></span></td>
                                                <td><%= Number(c.body_fat_pct).toFixed(1) %>%</td>
                                                <td>
                                                    <strong style="color:var(--accent-cyan);font-size:0.8rem;"><%= c.fitness_goal %></strong>
                                                    <div style="font-size:0.78rem;color:var(--text-secondary);"><%= c.trainer_notes %></div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>

    </main>

    <script>
        function switchTab(tabName, btnEl) {
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));

            const panel = document.getElementById('tab-' + tabName);
            if (panel) panel.classList.add('active');

            if (btnEl) {
                btnEl.classList.add('active');
            } else {
                const btn = document.querySelector(`.nav-btn[onclick*="${tabName}"]`);
                if (btn) btn.classList.add('active');
            }
            history.replaceState(null, '', '/dashboard?tab=' + tabName);
        }

        // Notification Drawer Toggle & Instant AJAX Read/Clear
        function toggleNotifDrawer(e) {
            e.stopPropagation();
            const drawer = document.getElementById('notifDrawer');
            drawer.classList.toggle('open');
            if (drawer.classList.contains('open')) {
                markAllNotificationsRead(false);
            }
        }

        document.addEventListener('click', () => {
            const drawer = document.getElementById('notifDrawer');
            if (drawer) drawer.classList.remove('open');
        });

        function markAllNotificationsRead(updateVisualList = true) {
            fetch('dashboard.php?ajax_notif=mark_read')
                .then(() => {
                    const badge = document.getElementById('notifBadge');
                    if (badge) badge.style.display = 'none';
                    if (updateVisualList) {
                        document.querySelectorAll('.notif-item.unread').forEach(el => el.classList.remove('unread'));
                    }
                });
        }

        function clearAllNotifications() {
            fetch('dashboard.php?ajax_notif=clear_all')
                .then(() => {
                    const badge = document.getElementById('notifBadge');
                    if (badge) badge.style.display = 'none';
                    const list = document.getElementById('notifListContainer');
                    if (list) {
                        list.innerHTML = '<div style="padding:28px 18px;text-align:center;color:var(--text-muted);font-size:0.84rem;">All notifications cleared.</div>';
                    }
                });
        }

        // Dynamic Billing Cycle Calculator for Member Upcoming Dues
        function selectBillingCycle(months, el) {
            document.getElementById('selectedCycleMonths').value = months;
            document.querySelectorAll('.cycle-option').forEach(c => c.classList.remove('selected'));
            if (el) el.classList.add('selected');
            recalcDuesPreview();
        }

        function recalcDuesPreview() {
            const planSelect = document.getElementById('duesPlanSelect');
            if (!planSelect) return;
            const selectedOpt = planSelect.options[planSelect.selectedIndex];
            const monthlyRate = parseFloat(selectedOpt.getAttribute('data-monthly')) || 1250;
            const months = parseInt(document.getElementById('selectedCycleMonths').value) || 3;

            let discount = 1.0;
            if (months === 3) discount = 0.95;
            if (months === 6) discount = 0.90;
            if (months === 12) discount = 0.85;

            const total = Math.round(monthlyRate * months * discount);
            document.getElementById('payablePreview').textContent = '₹' + total.toLocaleString('en-IN');
            document.getElementById('cycleSubtext').textContent = 'Extends membership by +' + months + (months === 1 ? ' Month' : ' Months');
        }

        document.addEventListener('DOMContentLoaded', recalcDuesPreview);
    </script>
</body>
</html>