<%
const bmi = bmiInfo(Number(profile.bmi) || 24.5);
const dueCls = days_remaining < 0 ? 'overdue' : (days_remaining <= 14 ? 'soon' : '');
const dueBadge = days_remaining < 0 ? ['red', '⚠ Membership expired (' + Math.abs(days_remaining) + ' days overdue)']
               : (days_remaining <= 14 ? ['amber', '⏳ Upcoming due reminder (renews in ' + days_remaining + ' days)']
               : ['green', '✓ Active billing cycle (' + days_remaining + ' days remaining)']);
const coach = bookings && bookings.length > 0 ? bookings[0] : null;
%>
<div class="page-head">
  <div><p class="eyebrow"><%= fdate(new Date().toISOString().split('T')[0]) %></p><h1 class="hero">Welcome back, <span class="grad"><%= actor_name.trim() %></span><span class="dotc">.</span></h1>
  <p class="muted">Your membership, training and billing at a glance.</p></div>
  <a class="btn" href="/member?page=bmi">Update my BMI →</a>
</div>

<section class="dues-banner <%= dueCls %>" data-testid="dues-banner">
  <div>
    <span class="badge <%= dueBadge[0] %>"><%= dueBadge[1] %></span>
    <h2>Current tier: <%= profile.plan_name || 'Gold VIP' %> · valid until <%= fdate(profile.plan_end_date) %></h2>
    <p>Renew or pre-pay your dues anytime with flexible <b>Monthly</b>, <b>Quarterly</b>, <b>Half-Yearly</b> or <b>Annual</b> cycles.</p>
  </div>
  <a class="btn primary" href="/member?page=billing">Pay upcoming dues / choose cycle →</a>
</section>

<div class="kpis">
  <div class="kpi sky"><small>My membership plan</small><strong><%= profile.plan_name || 'Standard' %></strong><span><%- statusBadge(profile.status) %> · ends <%= fdate(profile.plan_end_date) %></span></div>
  <div class="kpi cyan"><small>My current BMI</small><strong><%= Number(profile.bmi).toFixed(1) %></strong><span><%= bmi.label %> · <%= Number(profile.weight_kg).toFixed(1) %> kg / <%= Number(profile.height_cm).toFixed(0) %> cm</span></div>
  <div class="kpi green"><small>My locker & slot</small><strong><%= coach && coach.locker_number ? coach.locker_number : 'Unassigned' %></strong><span><%= coach && coach.slot_time ? coach.slot_time : 'Book a slot in My Slot & Locker' %></span></div>
  <div class="kpi amber"><small>Assigned coach</small><strong><%= coach && coach.trainer_name ? coach.trainer_name : 'None' %></strong><span><%= coach && coach.specialization ? coach.specialization : 'Personal Training' %></span></div>
</div>

<section class="card">
  <div class="card-head"><h2>Coach's programming & nutrition feedback for you</h2></div>
  <p style="margin-bottom:10px"><b>Current goal:</b> <span class="pill"><%= profile.fitness_goal || 'General Fitness' %></span></p>
  <p class="quote">“<%= profile.trainer_notes || 'Stay consistent with your weekly split.' %>”</p>
</section>
