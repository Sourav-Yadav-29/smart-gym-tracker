<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IronPulse — Member Portal</title>
<script>document.documentElement.dataset.theme = localStorage.getItem('ip-theme') || 'light';</script>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/member/assets/member.css">
</head>
<body>
<div class="backdrop" id="navBackdrop" onclick="toggleNav(false)"></div>
<aside class="sidebar" id="sidebar">
  <div class="brand"><div class="logo">IP</div><div><b>IRONPULSE</b><small>Member Portal</small></div></div>
  <div class="rbac"><b>RBAC Policy: Member</b><span>Personal member access & self-service billing</span></div>
  <nav>
    <a href="/member?page=overview" class="<%= page === 'overview' ? 'active' : '' %>" data-testid="nav-overview-link"><%- icon('grid') %><span>My Fitness Hub</span></a>
    <a href="/member?page=bmi" class="<%= page === 'bmi' ? 'active' : '' %>" data-testid="nav-bmi-link"><%- icon('activity') %><span>My BMI & Workouts</span></a>
    <a href="/member?page=schedule" class="<%= page === 'schedule' ? 'active' : '' %>" data-testid="nav-schedule-link"><%- icon('lock') %><span>My Slot & Locker</span><% if (counts.schedule) { %><em><%= counts.schedule %></em><% } %></a>
    <a href="/member?page=billing" class="<%= page === 'billing' ? 'active' : '' %>" data-testid="nav-billing-link"><%- icon('wallet') %><span>Upcoming Dues & Pay</span><% if (counts.billing) { %><em><%= counts.billing %></em><% } %></a>
  </nav>
  <div class="me"><span class="avatar"><%= initials(actor_name) %></span><div><b><%= actor_name %></b><small>● Member (#<%= actor_id %>)</small></div></div>
  <a class="signout" href="/logout" data-testid="signout-link">Sign out →</a>
</aside>

<div class="main">
  <header class="topbar">
    <button class="icon-btn mobile-only" onclick="toggleNav(true)" aria-label="Menu"><%- icon('menu') %></button>
    <div class="top-actions">
      <a class="btn primary" href="/member?page=billing" data-testid="topbar-pay-dues-button"><%- icon('bolt') %><span class="hide-sm">Pay upcoming dues</span></a>
      <div class="notif-wrap">
        <button class="icon-btn <%= locals.notif_pulse ? 'pulse' : '' %>" id="bellBtn" onclick="toggleNotif(event)" aria-label="Notifications" data-testid="notifications-button"><%- icon('bell') %>
          <% if (unread > 0) { %><span class="count" id="notifCount"><%= unread %></span><% } %></button>
        <div class="notif-panel" id="notifPanel" onclick="event.stopPropagation()">
          <div class="np-head"><b>Notifications & activity</b><span><button onclick="notifAction('read')">Mark read</button><button onclick="notifAction('clear')">Clear</button></span></div>
          <div class="np-list" id="notifList">
            <% if (!notifications || notifications.length === 0) { %><p class="empty">No notifications yet. Updates, BMI changes and payment confirmations appear here.</p><% } %>
            <% (notifications || []).forEach(n => { %>
              <div class="np-item <%= Number(n.is_read) ? '' : 'unread' %>"><div><span class="tag"><%= n.category %></span><time><%= fdt(n.created_at) %></time></div>
                <p><%= n.message %></p><small>— <%= n.actor_name %></small></div>
            <% }) %>
          </div>
        </div>
      </div>
      <button class="icon-btn" onclick="toggleTheme()" aria-label="Toggle theme" data-testid="theme-toggle-button"><span class="t-light"><%- icon('sun') %></span><span class="t-dark"><%- icon('moon') %></span></button>
    </div>
  </header>

  <main class="content">
    <% if (flash) { %><div class="toast <%= flash.type %>" id="toast" data-testid="flash-message"><%= flash.msg %><button onclick="this.parentNode.remove()"><%- icon('x') %></button></div><% } %>
    <%- body %>
  </main>
</div>
<script src="/member/assets/member.js"></script>
</body>
</html>
