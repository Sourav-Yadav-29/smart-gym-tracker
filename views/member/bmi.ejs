<% const bmi = bmiInfo(Number(profile.bmi) || 24.5); %>
<div class="page-head">
  <div><p class="eyebrow">Body metrics & training log</p><h1>My BMI & Workouts</h1></div>
  <span class="badge <%= bmi.color %>">BMI <%= Number(profile.bmi).toFixed(1) %> · <%= bmi.label %></span>
</div>

<div class="layout-12">
  <section class="card col-5">
    <div class="card-head"><h2>Update my weight & BMI</h2></div>
    <form class="form" method="post" action="/member/actions">
      <input type="hidden" name="action" value="update_biometrics">
      <input type="hidden" name="back" value="/member?page=bmi">
      <div class="grid2">
        <label>My height (cm)<input type="number" step="0.1" name="height_cm" value="<%= profile.height_cm %>" required></label>
        <label>My weight (kg)<input type="number" step="0.1" name="weight_kg" value="<%= profile.weight_kg %>" required></label>
        <label>Body fat (%)<input type="number" step="0.1" name="body_fat_pct" value="<%= profile.body_fat_pct %>" required></label>
        <label>My fitness goal<input type="text" name="fitness_goal" maxlength="100" value="<%= profile.fitness_goal %>" required></label>
      </div>
      <button class="btn primary block" type="submit">Recalculate my BMI</button>
    </form>
  </section>

  <section class="card flush col-7">
    <div class="card-head pad"><h2>My prescribed & logged workouts</h2><span class="muted"><%= workouts ? workouts.length : 0 %> entries</span></div>
    <div class="table-wrap"><table>
      <thead><tr><th>Date</th><th>Exercise</th><th>Group</th><th>Sets × Reps</th><th>Weight</th><th>Prescribed by</th></tr></thead>
      <tbody>
        <% if (!workouts || workouts.length === 0) { %><tr><td colspan="6" class="empty">No workouts logged yet.</td></tr><% } %>
        <% (workouts || []).forEach(w => { %>
          <tr><td class="mono nowrap"><%= fdate(w.workout_date) %></td><td><b><%= w.exercise_name %></b></td>
            <td><span class="badge violet"><%= w.muscle_group %></span></td>
            <td><%= w.sets %> × <%= w.reps %></td><td class="nowrap"><%= Number(w.weight_kg).toFixed(1) %> kg</td><td><%= w.coach_name || 'Self-Logged' %></td></tr>
        <% }) %>
      </tbody>
    </table></div>
  </section>
</div>
