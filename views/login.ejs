<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IronPulse | Sign In</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        surface: {
                            DEFAULT: '#0b0d14',
                            card: '#111827',
                            input: '#0f1117',
                            hover: '#161b26',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .font-display { font-family: 'Space Grotesk', sans-serif; }

        /* Faded ambient vignette background */
        .bg-radial-vignette {
            background: radial-gradient(circle at center, rgba(11, 13, 20, 0.35) 0%, rgba(11, 13, 20, 0.75) 60%, #07090e 100%);
        }

        /* Subtle checkerboard watermark on left edge */
        .card-checkerboard {
            background-image: 
                linear-gradient(45deg, rgba(255, 255, 255, 0.06) 25%, transparent 25%), 
                linear-gradient(-45deg, rgba(255, 255, 255, 0.06) 25%, transparent 25%), 
                linear-gradient(45deg, transparent 75%, rgba(255, 255, 255, 0.06) 75%), 
                linear-gradient(-45deg, transparent 75%, rgba(255, 255, 255, 0.06) 75%);
            background-size: 36px 36px;
            background-position: 0 0, 0 18px, 18px -18px, -18px 0px;
            mask-image: linear-gradient(to right, rgba(0,0,0,0.85) 0%, transparent 100%);
            -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0.85) 0%, transparent 100%);
        }

        .role-btn {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .role-btn.active {
            background: linear-gradient(135deg, rgba(249,115,22,0.18), rgba(245,158,11,0.12));
            border-color: rgba(249,115,22,0.65);
            color: #fb923c;
            box-shadow: 0 0 25px rgba(249,115,22,0.12);
        }
        .role-btn:not(.active):hover {
            background: rgba(255,255,255,0.03);
            border-color: rgba(255,255,255,0.15);
        }

        .glow-border {
            box-shadow: 0 30px 100px -15px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.08);
        }

        .input-field {
            transition: all 0.25s ease;
        }
        .input-field:focus {
            border-color: rgba(249,115,22,0.5);
            box-shadow: 0 0 0 3px rgba(249,115,22,0.08), 0 0 20px rgba(249,115,22,0.05);
        }

        .sign-in-btn {
            background: linear-gradient(135deg, #f97316, #f59e0b);
            transition: all 0.3s ease;
            box-shadow: 0 4px 24px rgba(249,115,22,0.25);
        }
        .sign-in-btn:hover {
            box-shadow: 0 8px 32px rgba(249,115,22,0.35);
            transform: translateY(-1px);
        }

        .quick-btn {
            transition: all 0.2s ease;
        }
        .quick-btn:hover {
            background: rgba(249,115,22,0.06);
            border-color: rgba(249,115,22,0.3);
            color: #fb923c;
        }

        .right-panel-img {
            background-image: url('https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
        }

        .eye-toggle {
            transition: color 0.2s ease;
        }
        .eye-toggle:hover {
            color: #fb923c;
        }

        /* Scrollbar styling */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0b0d14; }
        ::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 3px; }
    </style>
</head>
<body class="bg-[#07090e] text-white min-h-screen flex items-center justify-center p-4 md:p-8 relative selection:bg-orange-500 selection:text-white">

    <!-- FADED AMBIENT BACKGROUND IMAGE -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none select-none">
        <div class="absolute -inset-12 bg-cover bg-center filter blur-[55px] brightness-[0.24] contrast-[1.2] saturate-[0.6] scale-110"
            style="background-image: url('https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=2070&auto=format&fit=crop');">
        </div>
        <div class="absolute inset-0 bg-radial-vignette"></div>
        <div class="absolute inset-0 bg-black/30"></div>
    </div>

    <!-- Main Glass Container -->
    <div class="w-full max-w-6xl glow-border bg-[#0d1019]/90 backdrop-blur-2xl rounded-[32px] border border-white/[0.08] flex overflow-hidden min-h-[720px] shadow-2xl relative">

        <!-- Checkerboard watermark on left edge -->
        <div class="absolute left-0 top-0 bottom-0 w-36 pointer-events-none card-checkerboard opacity-25 z-0"></div>

        <!-- ==================== LEFT SIDE: Login Form (55%) ==================== -->
        <div class="w-full lg:w-[55%] p-8 md:p-12 lg:p-14 flex flex-col justify-center relative z-10">

            <!-- Branding -->
            <div class="flex items-center gap-3 mb-10">
                <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-amber-500 rounded-xl flex items-center justify-center font-display text-lg font-bold text-white shadow-lg shadow-orange-500/20">IP</div>
                <span class="font-display text-xl tracking-tight text-white">IronPulse</span>
            </div>

            <!-- Heading -->
            <div class="mb-8">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-2 font-display">Welcome Back</h2>
                <p class="text-white/40 text-sm">Keep moving. Keep growing.</p>
            </div>

            <!-- Error Message -->
            <% if (locals.error && error) { %>
                <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm flex items-center gap-3">
                    <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form method="POST" action="/login" id="loginForm">
                <!-- Role Selector Pills -->
                <div class="mb-7">
                    <label class="block text-xs font-semibold text-white/30 uppercase tracking-widest mb-3">Sign in as</label>
                    <div class="grid grid-cols-3 gap-2.5">
                        <button type="button" onclick="setRole('member')" id="btn-member" class="role-btn active py-3 px-3 rounded-xl border border-white/10 text-xs font-bold text-white/50 flex flex-col items-center gap-2">
                            <i data-lucide="user" class="w-5 h-5"></i>
                            Member
                        </button>
                        <button type="button" onclick="setRole('trainer')" id="btn-trainer" class="role-btn py-3 px-3 rounded-xl border border-white/10 text-xs font-bold text-white/50 flex flex-col items-center gap-2">
                            <i data-lucide="user-check" class="w-5 h-5"></i>
                            Trainer
                        </button>
                        <button type="button" onclick="setRole('admin')" id="btn-admin" class="role-btn py-3 px-3 rounded-xl border border-white/10 text-xs font-bold text-white/50 flex flex-col items-center gap-2">
                            <i data-lucide="shield" class="w-5 h-5"></i>
                            Admin
                        </button>
                    </div>
                    <input type="hidden" name="role" id="role-input" value="member">
                </div>

                <!-- Form Fields -->
                <div class="space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-white/50 mb-2">Email Address</label>
                        <input type="email" name="email" id="email-input" required
                            class="input-field w-full px-4 py-3.5 rounded-xl bg-surface-input border border-white/10 text-white placeholder-white/20 outline-none text-sm"
                            placeholder="Enter your email">
                    </div>
                    <div>
                        <div class="flex justify-between mb-2">
                            <label class="text-sm font-medium text-white/50">Password</label>
                            <a href="#" class="text-xs font-semibold text-orange-400/70 hover:text-orange-400 transition-colors">Forgot password?</a>
                        </div>
                        <div class="relative">
                            <input type="password" name="password" id="password-input" required
                                class="input-field w-full px-4 py-3.5 rounded-xl bg-surface-input border border-white/10 text-white placeholder-white/20 outline-none text-sm pr-12"
                                placeholder="••••••••">
                            <button type="button" onclick="togglePassword()" class="eye-toggle absolute right-4 top-1/2 -translate-y-1/2 text-white/25">
                                <i data-lucide="eye" class="w-4 h-4" id="eye-icon"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Remember Me -->
                <div class="flex items-center gap-2.5 my-6">
                    <input type="checkbox" id="remember" class="w-4 h-4 bg-surface-input border-white/20 rounded text-orange-500 focus:ring-orange-500/30 focus:ring-offset-0 focus:ring-2">
                    <label for="remember" class="text-sm text-white/35 font-medium">Remember for 30 days</label>
                </div>

                <!-- Sign In Button -->
                <button type="submit" class="sign-in-btn w-full py-4 text-white rounded-xl font-bold text-base flex items-center justify-center gap-2 mb-6">
                    Sign In
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </button>
            </form>

            <!-- Developer Quick Access Divider -->
            <div class="relative flex items-center justify-center mb-5">
                <div class="w-full border-t border-white/[0.06]"></div>
                <span class="absolute px-4 bg-surface-card text-[10px] font-bold text-white/20 uppercase tracking-[0.2em]">Developer Quick Access</span>
            </div>

            <!-- Quick Access Buttons -->
            <div class="grid grid-cols-1 gap-2">
                <button type="button" onclick="bypassLogin('member', 'member1@ironpulse.com')" class="quick-btn w-full py-3 px-4 rounded-xl border border-white/[0.06] text-xs font-semibold text-white/30 flex justify-between items-center">
                    <span class="flex items-center gap-2"><i data-lucide="zap" class="w-3.5 h-3.5"></i> Quick Access: Member (Alex)</span>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-40"></i>
                </button>
                <button type="button" onclick="bypassLogin('trainer', 'trainer1@ironpulse.com')" class="quick-btn w-full py-3 px-4 rounded-xl border border-white/[0.06] text-xs font-semibold text-white/30 flex justify-between items-center">
                    <span class="flex items-center gap-2"><i data-lucide="zap" class="w-3.5 h-3.5"></i> Quick Access: Trainer (Marcus)</span>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-40"></i>
                </button>
                <button type="button" onclick="bypassLogin('admin', 'admin@ironpulse.com')" class="quick-btn w-full py-3 px-4 rounded-xl border border-white/[0.06] text-xs font-semibold text-white/30 flex justify-between items-center">
                    <span class="flex items-center gap-2"><i data-lucide="zap" class="w-3.5 h-3.5"></i> Quick Access: Admin (Arthur)</span>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-40"></i>
                </button>
            </div>

            <!-- Bottom Link -->
            <p class="mt-8 text-center text-sm text-white/25">
                Don't have an account? <span class="font-bold text-orange-400/70 hover:text-orange-400 cursor-pointer transition-colors">Contact Management</span>
            </p>
        </div>

        <!-- ==================== RIGHT SIDE: Image Panel (45%) ==================== -->
        <div class="hidden lg:block lg:w-[45%] relative right-panel-img m-3 rounded-[24px] border border-white/10 overflow-hidden shadow-2xl">
        </div>
    </div>

    <script>
        lucide.createIcons();

        function setRole(role) {
            document.getElementById('role-input').value = role;

            // Update UI
            document.querySelectorAll('.role-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            document.getElementById('btn-' + role).classList.add('active');

            // Set example email for convenience
            const emailInput = document.getElementById('email-input');
            if (role === 'member') emailInput.placeholder = 'e.g. member@ironpulse.com';
            else if (role === 'trainer') emailInput.placeholder = 'e.g. coach@ironpulse.com';
            else if (role === 'admin') emailInput.placeholder = 'e.g. admin@ironpulse.com';
        }

        function bypassLogin(role, email) {
            const form = document.getElementById('loginForm');
            document.getElementById('role-input').value = role;

            document.getElementById('email-input').value = email;
            document.querySelector('input[type="password"]').value = 'password123';

            form.submit();
        }

        function togglePassword() {
            const input = document.getElementById('password-input');
            const icon = document.getElementById('eye-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.setAttribute('data-lucide', 'eye-off');
            } else {
                input.type = 'password';
                icon.setAttribute('data-lucide', 'eye');
            }
            lucide.createIcons();
        }
    </script>
</body>
</html>
